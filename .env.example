PORT=3001

DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET_KEY=replace-with-random-secret

KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_OIDC_AUDIENCE=replace-with-kakao-id-token-audience
# 탈퇴 시 카카오 unlink용 Admin 키 (카카오 디벨로퍼스 > 앱 키 > Admin 키)
KAKAO_ADMIN_KEY=replace-with-kakao-admin-key

APPLE_CLIENT_ID=com.newdok.test
APPLE_WEB_CLIENT_ID=
# Apple token exchange/revoke용 (탈퇴 시 Apple 연결 해제)
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
# .p8 키 파일을 base64 인코딩한 값 (또는 APPLE_PRIVATE_KEY_PATH로 파일 경로 지정)
APPLE_PRIVATE_KEY_BASE64=replace-with-base64-encoded-p8
# 소셜 refresh token 암호화 키. `openssl rand -base64 32`로 생성. 실사용 후 변경 금지
PROVIDER_TOKEN_ENCRYPTION_KEY=replace-with-32byte-base64-key

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
